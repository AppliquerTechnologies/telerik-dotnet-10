<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#4f46e5" />

    <title>@ViewData["Title"] - Orders</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    @* Kendo assets come from the CDN. Fluent theme, overridden in site.css. *@
    <link href="https://kendo.cdn.telerik.com/themes/14.5.0/fluent/fluent-main.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://unpkg.com/jszip/dist/jszip.min.js"></script>
    <script src="https://cdn.kendostatic.com/2026.3.811/js/kendo.all.min.js"></script>
    <script src="https://cdn.kendostatic.com/2026.3.811/js/kendo.aspnetmvc.min.js"></script>
    <script src="~/js/loader.js" asp-append-version="true"></script>
</head>
<body class="k-content">
    @{
        var current = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
        var onCursor = current.StartsWith("/Orders/Cursor");
        var onOffset = current.StartsWith("/Orders") && !onCursor;
        var userName = User.Identity?.Name ?? string.Empty;
        var isAdmin = User.IsInRole("Admin");
    }

    <header class="app-header">
        <div class="app-header__inner">
            <a class="brand" asp-page="/Orders/Index">
                <span class="brand__mark">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8 12 3 3 8v8l9 5 9-5V8Z"/><path d="m3 8 9 5 9-5M12 13v8"/></svg>
                </span>
                <span>Orders</span>
            </a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <nav class="app-nav" aria-label="Main">
                    <a asp-page="/Orders/Index" class="@(onOffset ? "is-active" : "")">Orders</a>
                    <a asp-page="/Orders/Cursor/Index" class="@(onCursor ? "is-active" : "")">Orders &middot; cursor</a>
                </nav>

                <form method="post" asp-page="/Auth/Logout" class="user-chip">
                    <span class="avatar" aria-hidden="true">@(userName.Length > 0 ? userName[..1] : "?")</span>
                    <span>
                        <span class="user-chip__name d-block">@userName</span>
                        <span class="role-badge @(isAdmin ? "" : "role-badge--readonly")">@(isAdmin ? "Admin" : "Read-only")</span>
                    </span>
                    <button type="submit" class="btn btn--ghost">Sign out</button>
                </form>
            }
        </div>
    </header>

    <main class="app-main">
        @RenderBody()
    </main>

    @RenderSection("Scripts", required: false)
</body>
</html>
