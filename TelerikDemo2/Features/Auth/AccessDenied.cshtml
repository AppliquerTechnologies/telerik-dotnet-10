@page "/AccessDenied"
@model TelerikDemo2.Features.Auth.AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
}

<div class="denied">
    <div class="icon">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
    </div>
    <h1>Access denied</h1>
    <p>Your account doesn't have permission to do that.</p>
    <a asp-page="/Orders/Index" class="btn btn--primary">Back to orders</a>
</div>
