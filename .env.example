# Copy to .env (git-ignored) and fill in.

# SQL Server sa password (8+ characters with upper, lower, digit and symbol; no ; or =).
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!Passw0rd

# Telerik NuGet API key, needed at build time.
TELERIK_NUGET_KEY=

# Contents of telerik-license.txt, needed at build time. Empty builds in trial mode.
TELERIK_LICENSE=

# Optional: host port for the web app.
# WEB_PORT=8080
