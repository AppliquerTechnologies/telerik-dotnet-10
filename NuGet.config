<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Telerik private feed. NO credentials are stored in this repo.
         Add them once to your USER-level NuGet config (not this file). See README, step 2.
         The source name must stay "TelerikOnlineFeed" so the user-level credentials match. -->
    <add key="TelerikOnlineFeed" value="https://nuget.telerik.com/v3/index.json" />
  </packageSources>
</configuration>
